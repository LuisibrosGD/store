{
  "info": {
    "name": "Gestión de Usuarios",
    "description": "API para la gestión de usuarios del sistema. Permite crear, consultar, actualizar, eliminar usuarios e iniciar sesión.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api"
    }
  ],
  "item": [
    {
      "name": "Listar todos los usuarios",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/usuarios",
          "host": ["{{baseUrl}}"],
          "path": ["usuarios"]
        },
        "description": "Obtiene el listado completo de usuarios registrados. Retorna un array de objetos con id, nombre y email."
      },
      "response": []
    },
    {
      "name": "Obtener usuario por ID",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/usuarios/1",
          "host": ["{{baseUrl}}"],
          "path": ["usuarios", "1"]
        },
        "description": "Obtiene los datos de un usuario específico por su identificador. Retorna 404 si no existe."
      },
      "response": []
    },
    {
      "name": "Crear usuario",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/usuarios",
          "host": ["{{baseUrl}}"],
          "path": ["usuarios"]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Nuevo Usuario\",\n  \"email\": \"nuevo@email.com\",\n  \"password\": \"pass123\"\n}"
        },
        "description": "Registra un usuario nuevo. El email debe ser único y la contraseña obligatoria. Retorna el usuario creado con su id."
      },
      "response": []
    },
    {
      "name": "Actualizar usuario",
      "request": {
        "method": "PUT",
        "url": {
          "raw": "{{baseUrl}}/usuarios/1",
          "host": ["{{baseUrl}}"],
          "path": ["usuarios", "1"]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Nombre Actualizado\",\n  \"email\": \"actualizado@email.com\",\n  \"password\": \"nueva123\"\n}"
        },
        "description": "Actualiza todos los datos de un usuario existente. Retorna 404 si no existe, 409 si el email pertenece a otro usuario."
      },
      "response": []
    },
    {
      "name": "Eliminar usuario",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/usuarios/1",
          "host": ["{{baseUrl}}"],
          "path": ["usuarios", "1"]
        },
        "description": "Elimina un usuario por su identificador. Retorna 204 sin contenido o 404 si no existe."
      },
      "response": []
    },
    {
      "name": "Iniciar sesión",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/usuarios/login",
          "host": ["{{baseUrl}}"],
          "path": ["usuarios", "login"]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"carlos@email.com\",\n  \"password\": \"1234\"\n}"
        },
        "description": "Autentica un usuario con email y contraseña. Retorna los datos del usuario o 401 si las credenciales son incorrectas."
      },
      "response": []
    }
  ]
}
